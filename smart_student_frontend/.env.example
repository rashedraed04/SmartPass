# =====================================================================
# Smart Student Helper - Environment Configuration
# =====================================================================

# Backend API Base URL Configuration:
#
# 1. Android Emulator (Default fallback on Android if not specified):
# API_BASE_URL=http://10.0.2.2:8000/api
#
# 2. Windows / macOS / Linux Desktop or Chrome Web (Default fallback on Desktop/Web):
# API_BASE_URL=http://127.0.0.1:8000/api
#
# 3. Physical Android / iOS Device over Wi-Fi:
# Replace with your computer's local IPv4 address (e.g. from `ipconfig`):
# API_BASE_URL=http://192.168.1.100:8000/api
#
# 4. Production Server:
# API_BASE_URL=https://api.smartstudent.university.edu/api
